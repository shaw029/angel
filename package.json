{
  "name": "angel",
  "version": "0.3.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "demo": "python3 -m http.server 3001 --directory demo",
    "start": "concurrently -n build,demo -c cyan,magenta \"vite build --watch\" \"python3 -m http.server 3001 --directory demo\"",
    "test": "node scripts/test.mjs && node --test tests/release.test.mjs",
    "prebuild": "npm run setup",
    "predev": "npm run setup",
    "prestart": "npm run setup",
    "version:check": "node scripts/version.mjs --check",
    "version:set": "node scripts/version.mjs",
    "check": "npm run version:check && npm run typecheck && npm test",
    "package": "npm run check && npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "esbuild": "^0.21.5"
  },
  "engines": {
    "node": ">=22"
  }
}
