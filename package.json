{
  "name": "angel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.wasm public/",
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "demo": "python3 -m http.server 3001 --directory demo",
    "start": "concurrently -n build,demo -c cyan,magenta \"vite build --watch\" \"python3 -m http.server 3001 --directory demo\""
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
